<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cognidolph – Brain performance coaching for founders</title>
<style>
:root{--bg:#f5f7f8;--surface:#fff;--ink:#14262e;--muted:#4a5f68;--line:#d3dadd;--navy:#1d3742;--on-navy:#eef4f6;--accent:#7BC86C;--accent-ink:#2f6b25;--focus:#2f6fcb;
color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1c22;--surface:#16272f;--ink:#e8f0f3;--muted:#a3b7bf;--line:#2a3f49;--navy:#0a141a;--on-navy:#eef4f6;--accent:#7BC86C;--accent-ink:#9be08a;--focus:#8ab8f5;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f1c22;--surface:#16272f;--ink:#e8f0f3;--muted:#a3b7bf;--line:#2a3f49;--navy:#0a141a;--on-navy:#eef4f6;--accent:#7BC86C;--accent-ink:#9be08a;--focus:#8ab8f5;color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif}
h1,h2,h3{font-family:Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;line-height:1.12;margin:0 0 .5em;letter-spacing:-.01em}
h1{font-size:clamp(2.3rem,6vw,4.2rem);font-weight:700}
h2{font-size:clamp(1.7rem,3.6vw,2.5rem);font-weight:700}
h3{font-size:1.2rem;font-weight:700}
p{margin:0 0 1em;max-width:62ch}
a{color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
section{padding:84px 0}
header{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
nav{display:flex;align-items:center;gap:22px;height:62px}
.logo{font:700 1.25rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;text-decoration:none;margin-right:auto}
nav a.l{text-decoration:none;color:var(--muted);font-weight:500;font-size:.95rem}
nav a.l:hover{color:var(--ink)}
.btn{display:inline-block;background:var(--accent);color:#04281a;font-weight:600;text-decoration:none;padding:12px 22px;border-radius:8px;border:0;font:600 1rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;cursor:pointer}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent;color:inherit;border:1.5px solid currentColor}
@media(max-width:760px){nav a.l{display:none}}
/* hero */
.hero{background:#6E9AA9;color:#0d242d;padding:72px 0 84px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center}
.hero p.lead{font-size:1.2rem;color:#0d242d;margin-bottom:1.6em}
.hero .row{display:flex;flex-wrap:wrap;gap:12px}
.focus{display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px}
.dotbtn{position:relative;width:250px;height:250px;border-radius:50%;border:1.5px solid rgba(255,255,255,.65);background:transparent;cursor:pointer;display:grid;place-items:center;color:inherit;font:inherit}
.dotbtn::before{content:"";position:absolute;inset:0;border-radius:50%;border:2px solid #fff;transform:scale(.55);opacity:.0}
.dotbtn.run::before{animation:ring 6s ease-in-out infinite}
@keyframes ring{0%,100%{transform:scale(.55);opacity:.9}50%{transform:scale(1);opacity:.15}}
.dot{width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 0 0 6px rgba(255,255,255,.3)}
.dotbtn.done .dot{background:#FFD700}
.count{font:700 2rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;min-height:1.3em}
.focus small{color:#0d242d;max-width:30ch;line-height:1.5}
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr}.dotbtn{width:210px;height:210px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.dotbtn.run::before{animation:none;transform:scale(.8);opacity:.6}}
.hero .btn:not(.ghost){background:#12303b;color:#fff}.hero .btn.ghost{color:#0d242d}.hero :focus-visible{outline-color:#fff}
.stripe{height:6px;background:linear-gradient(90deg,#4A90E2 0 25%,#7BC86C 25% 50%,#C4A7E7 50% 75%,#FFD700 75%)}
.logo img{display:block;height:36px;width:auto}.flogo{width:72px;height:72px;margin-bottom:12px}
.mascot{float:right;width:84px;height:auto;border-radius:16px;background:#fff;padding:4px;margin:0 0 8px 14px}
.steps li:nth-child(1){border-color:#4A90E2}.steps li:nth-child(2){border-color:#7BC86C}.steps li:nth-child(3){border-color:#C4A7E7}.steps li:nth-child(4){border-color:#FFD700}
/* sections */
.intro{display:grid;grid-template-columns:1fr 1fr;gap:48px}
@media(max-width:820px){.intro{grid-template-columns:1fr;gap:8px}section{padding:60px 0}}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--line)}
.grid>div{padding:28px 28px 28px 0;border-bottom:1px solid var(--line)}
.grid>div:nth-child(even){padding-left:28px;border-left:1px solid var(--line)}
@media(max-width:700px){.grid{grid-template-columns:1fr}.grid>div,.grid>div:nth-child(even){padding:22px 0;border-left:0}}
.muted{color:var(--muted)}
.steps{counter-reset:s;list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.steps li{counter-increment:s;border-top:3px solid var(--accent);padding-top:14px}
.steps li::before{content:counter(s);font:700 1.6rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;color:var(--accent-ink);display:block}
.steps b{display:block;font-family:Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;font-size:1.15rem;margin:2px 0 6px}
.steps span{color:var(--muted);font-size:.98rem}
@media(max-width:820px){.steps{grid-template-columns:1fr 1fr}}
.band{background:var(--surface);border-block:1px solid var(--line)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
@media(max-width:820px){.two{grid-template-columns:1fr;gap:28px}}
form{display:grid;gap:14px}
label{display:grid;gap:6px;font-weight:600;font-size:.95rem}
input{font:inherit;padding:12px 14px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
.fine{font-size:.88rem;color:var(--muted)}
.ok{display:none;border-left:4px solid var(--accent);padding:10px 16px;background:var(--bg)}
.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:28px}
@media(max-width:820px){.quotes{grid-template-columns:1fr}}
blockquote{margin:0;padding:0 0 0 18px;border-left:3px solid var(--line)}
blockquote p{font-size:1.02rem}
cite{font-style:normal;font-weight:600;display:block;font-size:.95rem}
cite span{display:block;font-weight:400;color:var(--muted);font-size:.88rem}
.avatar{width:96px;height:96px;border-radius:50%;background:var(--navy);color:var(--on-navy);display:grid;place-items:center;font:700 2rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif;margin-bottom:16px}
footer{background:var(--navy);color:#bcd0e0;padding:56px 0 40px;font-size:.95rem}
footer .cols{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px}
@media(max-width:760px){footer .cols{grid-template-columns:1fr}}
footer h4{color:#fff;margin:0 0 10px;font:700 1rem Gadugi,"Segoe UI",system-ui,-apple-system,sans-serif}
footer a{display:block;text-decoration:none;margin-bottom:6px}
footer a:hover{color:#fff}
footer .legal{border-top:1px solid rgba(255,255,255,.15);margin-top:32px;padding-top:20px;font-size:.88rem;color:#93a9bb}
</style>
</head>
