<script>
(function(){
var b=document.getElementById('dotbtn'),c=document.getElementById('count'),h=document.getElementById('hint'),t=null,n=30;
b.addEventListener('click',function(){
if(t){return}
n=30;b.classList.remove('done');b.classList.add('run');b.setAttribute('aria-label','Focus exercise running');
h.textContent='Keep your eyes on the dot. Breathe slowly.';c.textContent=n;
t=setInterval(function(){n--;c.textContent=n;
if(n<=0){clearInterval(t);t=null;b.classList.remove('run');b.classList.add('done');c.textContent='Done';
h.textContent='Notice how your attention feels now. Press the circle to repeat.';b.setAttribute('aria-label','Start a 30-second focus exercise')}},1000)});
var f=document.getElementById('lead');
f.addEventListener('submit',function(e){e.preventDefault();
var n=f.elements.name.value.trim(),m=f.elements.email.value.trim();
if(!n||!/^\S+@\S+\.\S+$/.test(m)){(!n?f.elements.name:f.elements.email).focus();return}
document.getElementById('ok').style.display='block';f.reset()});
})();
</script>
